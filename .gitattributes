# Corpus drawings are hashed in corpus.json; never let git rewrite their line endings.
*.dxf binary
*.DXF binary
*.dwg binary
*.DWG binary
corpus/** -text

# Vendored upstream code keeps its own line endings (acad-ts ships mixed CRLF/LF); patches depend on them.
third_party/acad-ts/** -text
third_party/acad-ts-patches/** -text
