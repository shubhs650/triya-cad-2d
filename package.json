{
  "name": "triya-cad-2d",
  "version": "0.0.0",
  "private": true,
  "description": "Triya CAD 2D: an AutoCAD-grade 2D drafting PWA (Open Engineering Tools)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^9.15.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node third_party/build-acad-ts.mjs",
    "build:acad-ts": "node third_party/build-acad-ts.mjs --force",
    "dev": "pnpm --filter @triya/web dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:fidelity": "playwright test --project=fidelity --pass-with-no-tests",
    "test:offline": "playwright test --project=offline --pass-with-no-tests",
    "test:ui": "playwright test --project=ui --pass-with-no-tests",
    "test:perf": "playwright test --project=perf --pass-with-no-tests",
    "test:io": "playwright test --project=io",
    "test:private": "node --experimental-strip-types scripts/test-private.ts",
    "corpus:list": "node --experimental-strip-types packages/testkit/src/corpus/cli.ts list",
    "corpus:validate": "node --experimental-strip-types packages/testkit/src/corpus/cli.ts validate",
    "changelog": "node --experimental-strip-types scripts/changelog.ts",
    "changelog:check": "node --experimental-strip-types scripts/changelog.ts --check",
    "fonts:build": "node --experimental-strip-types scripts/build-fonts.ts",
    "fixtures:underlay": "TRIYA_UPDATE_FIXTURES=1 vitest run packages/testkit/src/underlay",
    "fixtures:xref": "TRIYA_UPDATE_FIXTURES=1 vitest run packages/testkit/src/xref",
    "fixtures:raster": "TRIYA_UPDATE_FIXTURES=1 vitest run packages/testkit/src/raster",
    "fixtures:pdf": "TRIYA_UPDATE_FIXTURES=1 vitest run packages/testkit/src/pdf",
    "fixtures:attributes": "TRIYA_UPDATE_FIXTURES=1 vitest run packages/testkit/src/attributes/fixture.test.ts",
    "fixtures:page-setups": "TRIYA_UPDATE_FIXTURES=1 vitest run packages/testkit/src/page-setups/fixture.test.ts",
    "plotstyles:build": "TRIYA_UPDATE_PLOTSTYLES=1 vitest run packages/testkit/src/plot",
    "corpus:roundtrip": "vitest run packages/testkit/src/roundtrip/corpus-roundtrip.test.ts",
    "spike:read": "vitest run --config vitest.spike.config.ts packages/testkit/src/spike/read.spike.ts",
    "spike:roundtrip": "vitest run --config vitest.spike.config.ts packages/testkit/src/spike/roundtrip.spike.ts",
    "corpus:ref": "node scripts/not-yet.mjs corpus:ref M1-26",
    "planegcs:build": "node scripts/not-yet.mjs planegcs:build M9-01"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^7.4.0",
    "fast-check": "^4.10.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "pako": "file:third_party/pako-inflate"
    }
  }
}
