+  private static _cmColor(value: number): Color {
+    const method = (value >>> 24) & 0xff;
+    if (method === 0xc0) return Color.byLayer;
+    if (method === 0xc1) return new Color(value & 0xff);
+    return new Color((value >> 16) & 0xff, (value >> 8) & 0xff, value & 0xff);
+  }
